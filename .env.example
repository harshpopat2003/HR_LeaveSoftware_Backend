# Copy to .env and change the values. Never commit .env.
DATABASE_URL=postgresql+psycopg://hr_app:change_me@localhost:5432/hr_leave
TEST_DATABASE_URL=postgresql+psycopg://hr_app:change_me@localhost:5432/hr_test
# Long random string: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change_me_to_a_long_random_string
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
# The frontend address(es), comma separated
CORS_ORIGINS=http://localhost:5173
# true in production (HTTPS only cookies)
COOKIE_SECURE=false
TIMEZONE=Asia/Dubai
